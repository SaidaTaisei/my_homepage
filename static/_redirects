# Cloudflare Pages redirects: https://developers.cloudflare.com/pages/configuration/redirects/
# Redirects apply even when a file exists at the same path, so never redirect a prefix
# that contains real files (e.g. /author/Taisei-Saida/cv.pdf).
# Static rules first, then dynamic (splat / placeholder) rules.

# Old CV locations -> current CV
/files/cv.pdf                    /author/Taisei-Saida/cv.pdf  301
/ja/author/Taisei-Saida/cv.pdf   /author/Taisei-Saida/cv.pdf  301

# Old author profile pages
/author/Taisei-Saida/            /                            301
/author/Taisei-Saida             /                            301
/ja/author/Taisei-Saida/         /ja/                         301
/ja/author/Taisei-Saida          /ja/                         301

# Old publication type pages (Academic used numeric types)
/publication-type/1/             /publication_types/paper-conference/  301
/publication-type/2/             /publication_types/article-journal/   301

# Old Netlify CMS admin
/admin/                          /                            301

# Old sections (Academic theme) -> new sections (Hugo Blox)
/talk/*                          /events/:splat               301
/publication/*                   /publications/:splat         301
/post/*                          /blog/:splat                 301
/tag/*                           /tags/                       301
/category/*                      /blog/                       301
/author/:name/                   /                            301
/ja/author/:name/                /ja/                         301
